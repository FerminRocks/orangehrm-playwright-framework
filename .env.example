# Example environment variables for local development
# These are public demo credentials for the OrangeHRM demo site and must NOT be used for production.

ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# Notes:
# - This file is intended as an example only. Do NOT commit your real credentials.
# - Create a local `.env` with these keys for convenience when running tests locally. `.env` must be added to .gitignore and must never be committed to the repository.
